{
  "name": "shanda-fuel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke:staging-platform": "node --conditions=react-server --import tsx scripts/staging-platform-smoke.ts",
    "drill:staging-r2-recovery": "node --conditions=react-server --import tsx scripts/staging-r2-recovery-drill.ts",
    "test:e2e": "playwright test",
    "test:e2e:owner-demo": "OWNER_DEMO_E2E=1 playwright test --config playwright.owner-demo.config.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "smoke:production-readonly": "node --conditions=react-server --import tsx scripts/production-readonly-smoke.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --import tsx scripts/seed-development.ts",
    "db:migrate:test": "drizzle-kit migrate",
    "db:seed:demo": "vitest run --config vitest.dev-seed.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@clerk/backend": "^3.26.2",
    "@clerk/nextjs": "^7.9.20",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.4.3",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@clerk/testing": "^2.2.47",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
