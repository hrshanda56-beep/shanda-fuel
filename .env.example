# Application
APP_ENV=local
APP_URL=http://localhost:3000
# Staging and production require separate HTTPS origins and secret-manager
# entries. DATABASE_DIRECT_URL is migration-only and must not reach the app.

# Database
DATABASE_URL=
DATABASE_DIRECT_URL=

# Clerk (the only authentication provider)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Configure Clerk's login MFA policy to match this application policy.
REQUIRE_LOGIN_MFA=true
# Security invariant: this must remain true. The application rejects false.
REQUIRE_PRIVILEGED_STEP_UP=true

# Development Owner seed: preview with pnpm db:seed, apply with pnpm db:seed --apply.
# Supply your own existing Clerk development user and company values.
SEED_CLERK_USER_ID=
SEED_TENANT_SLUG=
SEED_TENANT_NAME=

# Private object storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Immutable private-object recovery destination. Requires a separate private
# bucket, independent credentials, Bucket Lock, and an approved retention policy.
R2_RECOVERY_BUCKET=
R2_RECOVERY_ACCESS_KEY_ID=
R2_RECOVERY_SECRET_ACCESS_KEY=

# Email adapter
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Jobs / cron
CRON_SECRET=

# Audit signing configuration
AUDIT_SIGNING_KEY_ID=
AUDIT_SIGNING_KEY=
